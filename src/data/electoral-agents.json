  "version": "1.0.0",
  "scope": {
    "office": "Deputado Estadual",
    "uf": "RS",
    "years": [
      2018,
      2022,
      2026
    ],
    "round": 1
  },
  "agents": [
    {
      "id": "electoral-intelligence",
      "role": "orchestrator",
      "areas": [
        "overview",
        "history",
        "territory",
        "competition"
      ],
      "responsibilities": [
        "resolve intent",
        "validate scope",
        "select specialist",
        "select skills",
        "enforce evidence chain"
      ],
      "must_not": [
        "calculate metrics",
        "invent formulas",
        "query raw files directly"
      ]
    },
    {
      "id": "electoral-overview",
      "role": "specialist",
      "areas": [
        "overview"
      ],
      "responsibilities": [
        "state overview",
        "candidate participation",
        "rankings",
        "distribution",
        "concentration"
      ],
      "must_not": [
        "change scope",
        "calculate ad hoc"
      ]
    },
    {
      "id": "electoral-history",
      "role": "specialist",
      "areas": [
        "history"
      ],
      "responsibilities": [
        "historical comparison",
        "growth and decline",
        "trajectory",
        "stability",
        "comparability"
      ],
      "must_not": [
        "call a three-election series a robust statistical trend"
      ]
    },
    {
      "id": "electoral-territory",
      "role": "specialist",
      "areas": [
        "territory"
      ],
      "responsibilities": [
        "municipal ranking",
        "territorial strength",
        "concentration",
        "distribution",
        "regional profile"
      ],
      "must_not": [
        "confuse municipality and electoral zone"
      ]
    },
    {
      "id": "electoral-competition",
      "role": "specialist",
      "areas": [
        "competition"
      ],
      "responsibilities": [
        "candidate ranking",
        "margins",
        "competitors",
        "territorial overlap",
        "municipal and regional competition",
        "fragmentation",
        "effective number"
      ],
      "must_not": [
        "include the target candidate as a competitor",
        "treat competition as a single universal metric"
      ]
    }
  ],
