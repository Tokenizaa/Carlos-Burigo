    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.14.0",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^7.3.6",
